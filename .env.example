DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE
DJANGO_SECRET_KEY=cambia-esta-clave-local-por-una-aleatoria-larga
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,app
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Por defecto el enlace se imprime en la terminal del backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@domipedidosx.local
# Para correo real, cambia EMAIL_BACKEND a django.core.mail.backends.smtp.EmailBackend
# y configura un remitente autorizado por el proveedor. No subas el .env.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
