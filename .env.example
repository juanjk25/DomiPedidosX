# Copia este archivo como .env y reemplaza DATABASE_URL con la URI
# de Supabase: Dashboard > Connect > Session pooler (recomendado en IPv4).
# Codifica los caracteres especiales de la contraseña como URL-encoding.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
